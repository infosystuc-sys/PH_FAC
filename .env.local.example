SQLSERVER_HOST=INFOSYS01
SQLSERVER_INSTANCE=AXSQLSERVER
SQLSERVER_DB=PUNTO_HOGAR_1
SQLSERVER_USER=Axoft
# El valor real va en .env.local (no trackeado). No commitear contraseñas.
SQLSERVER_PASSWORD=

# Carpeta donde se guardan los PDF importados
PHF_STORAGE_DIR=D:\APP\PH_FAC\storage

# Opcional: fuerza el usuario de auditoria en lugar del usuario de Windows
# PHF_USUARIO=

ANTHROPIC_API_KEY=

# CUIT de la empresa que usa la app (el CLIENTE de las facturas que se
# importan). Sirve para que la IA no confunda al emisor con el receptor:
# se le dice explicitamente que este CUIT nunca es el del proveedor, y la
# validacion lo bloquea si igual aparece ahi.
PHF_CUIT_PROPIO=30-70237535-1
